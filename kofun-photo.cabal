cabal-version:      3.0
name:               kofun-photo
version:            0.1.0.0
synopsis:           Haskell static site generator for a nationwide kofun atlas
description:        Generates the Kofun Meguri interactive map and quiz for GitHub Pages.
category:           Web
maintainer:         hjosugi
license:            0BSD
build-type:         Simple

source-repository head
  type:             git
  location:         https://github.com/hjosugi/kofun-gallery.git

executable kofun-build
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat
  build-depends:
      aeson      >= 2.2 && < 2.3
    , base       >= 4.18 && < 5
    , bytestring >= 0.11 && < 0.13
    , directory  >= 1.3 && < 1.4
    , filepath   >= 1.4 && < 1.6
    , text       >= 2.0 && < 2.2
